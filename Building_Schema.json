{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Building_Schema.json",
    "title": "Building Schema",
    "type": "object",
    "required": ["building_name", "floors"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "building_name": {
            "type": "string"
        },
        "floors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["floorNumber", "nodes"],
                "properties": {
                    "floorNumber": {
                        "type": "integer"
                    },
                    "nodes": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["id", "isExit", "x", "y", "edges"],
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "isExit": {
                                    "type": "boolean"
                                },
                                "x": {
                                    "type": "number"
                                },
                                "y": {
                                    "type": "number"
                                },
                                "edges": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": ["nodeID"],
                                        "properties": {
                                            "nodeID": {
                                                "type": "string"
                                            },
                                            "biDirectional": {
                                                "type": "boolean",
                                                "default": true
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}